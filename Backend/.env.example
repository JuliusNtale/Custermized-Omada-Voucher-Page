# ==========================================================================
# Wi-Fi Business Backend - environment configuration
# Copy this file to .env  (cp .env.example .env) and fill in real values.
# NEVER commit .env. All secrets below are server-side only.
# ==========================================================================

# --- App ---
NODE_ENV=development
HOST=localhost
PORT=3000
LOG_LEVEL=info
APP_URL=

# --- Database (SQLite, single file; Docker overrides this to a volume path) ---
DATABASE_URL=file:./prisma/dev.db

# --- Omada Open API (Settings -> Open API -> Application: WiFi Business Backend) ---
# In Docker Compose on a shared network, use the service name, NOT a container IP.
# The OpenAPI base path is /openapi/v1 (see src/modules/omada/omada.paths.ts).
OMADA_BASE_URL=https://omada:8043
OMADA_CLIENT_ID=
OMADA_CLIENT_SECRET=
OMADA_ID=
OMADA_SITE_ID=
OMADA_MODE=real
# Omada uses self-signed TLS; keep verification on only if you installed a trusted cert.
OMADA_TLS_REJECT_UNAUTHORIZED=false
OMADA_HTTP_TIMEOUT_MS=15000
OMADA_TOKEN_TTL_SAFETY_S=60

# --- Payment provider ---
# fake:     in-memory dev/test provider, no real money moves (spec section 32).
# clickpesa: real mobile-money (USSD-PUSH) via docs.clickpesa.com.
PAYMENT_PROVIDER=fake
PAYMENT_API_URL=
PAYMENT_API_KEY=
PAYMENT_API_SECRET=
# Public webhook URL registered in the ClickPesa dashboard
# (Settings -> Developers -> app -> Application Webhooks).
PAYMENT_CALLBACK_URL=
# HMAC secret used to verify inbound webhook signatures; falls back to
# PAYMENT_API_SECRET, then to a fixed dev-only value, when unset.
PAYMENT_WEBHOOK_SECRET=

# --- ClickPesa (PAYMENT_PROVIDER=clickpesa; see docs.clickpesa.com) ---
# Client ID + API Key come from ClickPesa Dashboard -> Settings -> Developers
# -> (application) -> Manage API Keys.
CLICKPESA_BASE_URL=https://api.clickpesa.com
CLICKPESA_CLIENT_ID=
CLICKPESA_API_KEY=
# Checksum key from the ClickPesa dashboard (Settings -> Developers -> app).
# REQUIRED in production with PAYMENT_PROVIDER=clickpesa - without it inbound
# webhooks cannot be authenticated (the backend refuses to boot).
CLICKPESA_CHECKSUM_SECRET=

# --- Captive portal (Omada External Portal Server, authType=4) ---
PORTAL_PUBLIC_URL=https://portal.neuraltale.com
# 'api' (default) authorises the client via the Omada Open API after payment;
# 'portal' makes the portal page POST the classic external-portal form to
# OMADA_PORTAL_AUTH_URL instead (fallback).
OMADA_PORTAL_AUTH_MODE=api
OMADA_PORTAL_AUTH_URL=

# --- Background job queue (voucher provisioning) ---
JOB_POLL_INTERVAL_MS=2000
JOB_BATCH_SIZE=5

# --- Admin access (shared secret for now; RBAC later) ---
ADMIN_API_KEY=